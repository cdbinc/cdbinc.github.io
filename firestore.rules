rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // SÉCURISÉ : aucun accès client direct. Tout l'accès aux données passe par
    // le backend (Admin SDK / compte de service), qui CONTOURNE ces règles.
    // Aucune app cliente CDB ne lit Firestore directement (FCM = messagerie,
    // pas Firestore ; les données ops vivent dans cdb-studio/ops/DATA).
    // Si un jour un client doit lire/écrire, ajouter une règle ciblée et
    // authentifiée ici — JAMAIS de « allow read, write: if true » global.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
